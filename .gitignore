# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js build
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# environment & secrets
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.p12
*.pfx

# compressed archives & backups (prevent data leakage)
*.zip
*.rar
*.7z
*.tar
*.tar.gz
*.tgz
*.bak
*.backup
*.dump
*.sql
*.sqlite*
*.db

# sensitive documents & exported files
*.pdf
*.docx
*.doc
/public/documents/
/documents/
/backups/
/backup/
/images/

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# system & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# vercel
.vercel
